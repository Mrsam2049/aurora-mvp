# .gitignore — Aurora
# Evitar subir información sensible al repositorio.

# Credenciales y variables de entorno 
.env
.env.*
*.env
# Único permitido: la plantilla SIN valores reales
!.env.example
# Volcados que generan los scripts 
vector_stores.env
master_store.env

# Llaves / certificados / secretos (defensa en profundidad)
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
*.keystore
id_rsa
id_rsa.*
*.secret
secrets.json
credentials*.json
serviceaccount*.json
service-account*.json
*.tfvars

# Base de conocimiento — contenido propietario del curso
# Los PDFs ya están subidos a OpenAI (objetos file-…); la app NO los necesita

kb/
*.pdf

# Dependencias
node_modules/
.npm/
.pnp.*
.yarn/*

# Build 
dist/
build/
*.tsbuildinfo

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caché / cobertura / temporales
.cache/
.eslintcache
coverage/
.nyc_output/
tmp/
temp/
*.tmp
*.bak
*~

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores / IDE
.vscode/
.idea/
*.swp
*.swo
